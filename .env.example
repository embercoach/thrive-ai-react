# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored by default in Vite projects — never commit real keys.

VITE_SUPABASE_URL=https://jjftkkpzyzojtxulpfcj.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Push notifications (Web Push / VAPID). The public key is safe to expose
# to the client; the private key must ONLY ever be set in Vercel (never in
# this file, never committed) since it's what lets the server sign
# notifications as this app.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Error monitoring (Sentry) — both are optional; everything that reads them
# (src/lib/sentry.ts, api/_lib/sentry.ts) is a no-op until they're set, so
# local dev works fine with neither. Set both in Vercel's project settings
# once you have a Sentry project — a client-side DSN (VITE_-prefixed, safe
# to expose) and, usually the same DSN, for the serverless functions.
VITE_SENTRY_DSN=your-sentry-dsn-here
SENTRY_DSN=your-sentry-dsn-here
